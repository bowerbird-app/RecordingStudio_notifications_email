<%= render FlatPack::PageTitle::Component.new(
  title: "Pages",
  subtitle: "Create pages and open threaded comments with notifications.",
  variant: :h1
) %>

<%= render FlatPack::Grid::Component.new(cols: 1, gap: :lg) do %>

  <%= render FlatPack::Card::Component.new(border: :default, shadow: :none) do |card| %>
    <% card.header do %>
      <%= render FlatPack::PageTitle::Component.new(
        title: "Create page",
        subtitle: "Saves the page and tells people who can see this workspace.",
        variant: :h3,
        class: "mb-0 pb-0"
      ) %>
    <% end %>

    <% card.body do %>
      <%= form_with url: pages_path, scope: :page, method: :post do %>
        <%= render FlatPack::TextInput::Component.new(
          name: "page[title]",
          value: params.dig(:page, :title),
          label: "Page title",
          required: true,
          placeholder: "Quarterly roadmap"
        ) %>

        <% workspace_choices = @workspaces.map { |workspace| [workspace.name, workspace.id] } %>
        <%= render FlatPack::Select::Component.new(
          name: "page[workspace_id]",
          label: "Workspace",
          required: true,
          value: params.dig(:page, :workspace_id).presence || workspace_choices.dig(0, 1),
          options: workspace_choices
        ) %>

        <%= render FlatPack::Select::Component.new(
          name: "page[parent_folder_id]",
          label: "Parent folder (optional)",
          placeholder: "This workspace",
          value: params.dig(:page, :parent_folder_id).presence,
          options: @folders.map { |folder| [folder.name, folder.id] }
        ) %>

        <%= render FlatPack::Button::Component.new(
          text: "Create page",
          style: :primary,
          size: :md,
          type: :submit
        ) %>
      <% end %>
    <% end %>
  <% end %>

  <%= render FlatPack::Card::Component.new(border: :default, shadow: :none) do |card| %>
    <% card.header do %>
      <%= render FlatPack::PageTitle::Component.new(
        title: "Existing pages",
        subtitle: "Open each page comment feed from here.",
        variant: :h3,
        class: "mb-0 pb-0"
      ) %>
    <% end %>

    <% card.body do %>
      <% if @pages.empty? %>
        <%= render FlatPack::EmptyState::Component.new(
          title: "No pages yet",
          description: "Create one to start a comment thread."
        ) %>
      <% else %>
        <%= render FlatPack::List::Component.new(divider: true) do %>
          <% @pages.each do |page| %>
            <% recording = @recordings_by_page_id[page.id] %>
            <% comments = if recording.present?
                 render(RecordingStudioCommentable::CommentsButton::Component.new(recording: recording))
               else
                 render(FlatPack::Button::Component.new(
                   text: "Comments unavailable",
                   style: :secondary,
                   size: :sm,
                   disabled: true
                 ))
               end %>
            <%= render FlatPack::List::Item.new(trailing: comments) do %>
              <%= page.title.presence || "Untitled page" %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
