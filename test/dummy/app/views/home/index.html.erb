<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Page mail",
    subtitle: "Create a page and mail the people in this workspace.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(border: :default, shadow: :none) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Create page",
          subtitle: "Saves the page and mails people who can see this workspace.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <%= form_with url: pages_path, scope: :page, method: :post, class: "space-y-4" do |f| %>
          <%= render FlatPack::TextInput::Component.new(
            name: "page[title]",
            value: params.dig(:page, :title),
            label: "Page title",
            required: true,
            placeholder: "New product spec"
          ) %>

          <div class="space-y-2">
            <label class="text-sm font-medium">Workspace</label>
            <%= f.select :workspace_id,
                         workspaces_you_can_change.map { |workspace| [workspace.name, workspace.id] },
                         {},
                         class: "w-full rounded-md border px-3 py-2 text-sm" %>
          </div>

          <div class="space-y-2">
            <label class="text-sm font-medium">Parent folder (optional)</label>
            <%= f.select :parent_folder_id,
                         [["This workspace", ""]] + folders_you_can_use.map { |folder| [folder.name, folder.id] },
                         {},
                         class: "w-full rounded-md border px-3 py-2 text-sm" %>
          </div>

          <%= render FlatPack::Button::Component.new(
            text: "Create page + notify workspace users",
            style: :primary,
            size: :md,
            type: :submit
          ) %>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(border: :default, shadow: :none) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Install flow",
          subtitle: "What the host app generator path covers.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li>Add the gem to your host app and run <code>bundle install</code>.</li>
          <li>Run <code>rails generate recording_studio_notifications_email:install</code> to add configuration.</li>
          <li>Run <code>rails generate recording_studio_notifications_email:migrations</code>, then migrate. That adds the address suppression table.</li>
          <li>Register <code>Webhooks::ApplyEvent</code> with your webhook provider. This gem mounts no inbound route of its own.</li>
          <li>Rebuild Tailwind if needed with <code>bin/rails tailwindcss:build</code>.</li>
        </ul>
      <% end %>
    <% end %>
  </div>
</div>
