<%= render FlatPack::PageTitle::Component.new(
  title: "Page mail",
  subtitle: "Create a page and mail the people in this workspace.",
  variant: :h1
) %>

<%= render FlatPack::Grid::Component.new(cols: 2, gap: :lg) do %>
    <%= render FlatPack::Card::Component.new(border: :default, shadow: :none) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Create page",
          subtitle: "Saves the page and mails people who can see this workspace.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <%= form_with url: pages_path, scope: :page, method: :post do %>
          <%= render FlatPack::TextInput::Component.new(
            name: "page[title]",
            value: params.dig(:page, :title),
            label: "Page title",
            required: true,
            placeholder: "New product spec"
          ) %>

          <% workspace_choices = workspaces_you_can_change.map { |workspace| [workspace.name, workspace.id] } %>
          <%= render FlatPack::Select::Component.new(
            name: "page[workspace_id]",
            label: "Workspace",
            required: true,
            value: params.dig(:page, :workspace_id).presence || workspace_choices.dig(0, 1),
            options: workspace_choices
          ) %>

          <%= render FlatPack::Select::Component.new(
            name: "page[parent_folder_id]",
            label: "Parent folder (optional)",
            placeholder: "This workspace",
            value: params.dig(:page, :parent_folder_id).presence,
            options: folders_you_can_use.map { |folder| [folder.name, folder.id] }
          ) %>

          <%= render FlatPack::Button::Component.new(
            text: "Create page + notify workspace users",
            style: :primary,
            size: :md,
            type: :submit
          ) %>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(border: :default, shadow: :none) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Install flow",
          subtitle: "What the host app generator path covers.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <%= render FlatPack::List::Component.new(ordered: true, spacing: :dense) do %>
          <% [
            ["Add the gem to the host app.", "bundle install"],
            ["Add configuration.", "bin/rails generate recording_studio_notifications_email:install"],
            ["Add the address suppression table, then migrate.", "bin/rails generate recording_studio_notifications_email:migrations"],
            ["Register the webhook action. This gem mounts no inbound route.", "RecordingStudioNotificationsEmail::Webhooks::ApplyEvent.register!"],
            ["Rebuild styles when the host serves its own CSS.", "bin/rails tailwindcss:build"]
          ].each do |step, command| %>
            <%= render FlatPack::List::Item.new do %>
              <p><%= step %></p>
              <%= render FlatPack::CodeBlock::Component.new(language: :bash, title: "Terminal", wrap: false, code: command) %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
<% end %>
