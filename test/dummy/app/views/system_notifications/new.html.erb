<%= render FlatPack::PageTitle::Component.new(
  title: "System notifications",
  subtitle: "Send an in-app notice to people who can open this workspace.",
  variant: :h2
) %>

<%= render FlatPack::Card::Component.new(border: :default, shadow: :none) do |card| %>
  <% card.body do %>
    <%= form_with url: system_notifications_path, scope: :system_notification, method: :post, class: "space-y-4" do %>
      <%= render FlatPack::TextInput::Component.new(
        name: "system_notification[title]",
        value: params.dig(:system_notification, :title),
        label: "Title",
        required: true,
        placeholder: "System announcement"
      ) %>

      <%= render FlatPack::TextArea::Component.new(
        name: "system_notification[body]",
        value: params.dig(:system_notification, :body) || @default_message,
        label: "Body",
        rows: 4,
        required: true
      ) %>

      <div>
        <%= render FlatPack::Button::Component.new(
          text: "Send to this workspace",
          style: :primary,
          size: :md,
          type: :submit
        ) %>
      </div>
    <% end %>
  <% end %>
<% end %>
