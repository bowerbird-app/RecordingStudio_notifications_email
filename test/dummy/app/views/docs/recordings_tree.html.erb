<%= render FlatPack::PageTitle::Component.new(
    title: "This workspace",
    subtitle: "Pages and folders in the workspace you're in.",
    variant: :h1
  ) %>

  <% if @recording_tree.any? %>
    <%= render FlatPack::Tree::Component.new(compact: true) do |tree| %>
      <% @recording_tree.each do |node| %>
        <%= render partial: "recording_tree_node", locals: { parent_builder: tree, node: node } %>
      <% end %>
    <% end %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "Nothing here yet",
      description: "Pages and folders show up after you add them to this workspace."
    ) %>
  <% end %>
