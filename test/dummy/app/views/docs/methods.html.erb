<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Methods & Hooks",
    subtitle: "Public methods in this gem, what they call, and where they delegate to RecordingStudioNotifications core.",
    variant: :h1
  ) %>

  <% sections = [
    {
      title: "RecordingStudioNotificationsEmail.mark_delivered!",
      subtitle: "Core call: yes (via this gem). Delegates to DeliveryCallbacks, resolves signed IDs, then invokes core delivery mutation methods.",
      code: <<~'RUBY'
        result = RecordingStudioNotificationsEmail.mark_delivered!(
          reference: params[:reference],
          delivered_at: Time.current
        )

        puts result.updated_delivery_ids
      RUBY
    },
    {
      title: "RecordingStudioNotificationsEmail.mark_opened!",
      subtitle: "Core call: yes (via this gem). Delegates to DeliveryCallbacks for opened events and applies core delivery/opened semantics.",
      code: <<~'RUBY'
        result = RecordingStudioNotificationsEmail.mark_opened!(
          reference: params[:reference],
          opened_at: Time.current
        )

        puts result.event_type
      RUBY
    },
    {
      title: "RecordingStudioNotificationsEmail.mark_clicked!",
      subtitle: "Core call: yes (via this gem). Delegates to DeliveryCallbacks and applies clicked callbacks on core delivery records.",
      code: <<~'RUBY'
        RecordingStudioNotificationsEmail.mark_clicked!(
          reference: params[:reference],
          clicked_at: Time.current
        )
      RUBY
    },
    {
      title: "RecordingStudioNotificationsEmail.mark_bounced!",
      subtitle: "Core call: yes (via this gem). Delegates to DeliveryCallbacks and applies bounced callbacks on core delivery records.",
      code: <<~'RUBY'
        RecordingStudioNotificationsEmail.mark_bounced!(
          reference: params[:reference],
          bounced_at: Time.current
        )
      RUBY
    },
    {
      title: "RecordingStudioNotificationsEmail.mark_complained_from_reference!",
      subtitle: "Core call: yes (via this gem). Delegates to DeliveryCallbacks and applies complained/spam-report callbacks on core delivery records.",
      code: <<~'RUBY'
        RecordingStudioNotificationsEmail.mark_complained_from_reference!(
          reference: params[:reference],
          complained_at: Time.current
        )
      RUBY
    },
    {
      title: "RecordingStudioNotificationsEmail.mark_unsubscribed_from_reference!",
      subtitle: "Core call: yes (via this gem). Delegates to DeliveryCallbacks and applies unsubscribed/opt-out callbacks on core delivery records.",
      code: <<~'RUBY'
        RecordingStudioNotificationsEmail.mark_unsubscribed_from_reference!(
          reference: params[:reference],
          unsubscribed_at: Time.current
        )
      RUBY
    },
    {
      title: "RecordingStudioNotificationsEmail.process_webhook_event!",
      subtitle: "Core call: yes (via this gem). Main webhook processing entrypoint; normalizes WebhookEvent and dispatches to DeliveryCallbacks.",
      code: <<~'RUBY'
        event = RecordingStudioNotificationsEmail::WebhookEvent.new(
          provider: :postmark,
          event_type: :delivered,
          reference: params[:reference],
          occurred_at: Time.current,
          external_event_id: "evt_123",
          metadata: { "stream" => "outbound" }
        )

        result = RecordingStudioNotificationsEmail.process_webhook_event!(event: event)
        puts result.updated_delivery_ids
      RUBY
    },
    {
      title: "RecordingStudioNotificationsEmail::DeliveryToken.sign",
      subtitle: "Core call: no. Signs notification/delivery IDs into a tamper-resistant token for outbound headers and webhook callbacks.",
      code: <<~'RUBY'
        token = RecordingStudioNotificationsEmail::DeliveryToken.sign(
          notification: notification,
          delivery: delivery
        )
      RUBY
    },
    {
      title: "RecordingStudioNotificationsEmail::DeliveryToken.verify",
      subtitle: "Core call: no. Soft verifier returning DeliveryToken::Reference for valid tokens and nil for invalid/expired tokens.",
      code: <<~'RUBY'
        reference = RecordingStudioNotificationsEmail::DeliveryToken.verify(params[:reference])
        return head :bad_request if reference.nil?

        puts reference.delivery_ids
      RUBY
    },
    {
      title: "RecordingStudioNotificationsEmail::DeliveryToken.verify!",
      subtitle: "Core call: no. Strict verifier returning DeliveryToken::Reference or raising ActiveSupport::MessageVerifier::InvalidSignature.",
      code: <<~'RUBY'
        reference = RecordingStudioNotificationsEmail::DeliveryToken.verify!(params[:reference])
        puts reference.notification_id
      RUBY
    },
    {
      title: "Hook Contract: Delivery callback methods",
      subtitle: "Core contract: yes. These methods must exist on RecordingStudioNotifications::Delivery and are invoked by this gem during webhook transitions.",
      code: <<~'RUBY'
        # Preferred methods on RecordingStudioNotifications::Delivery
        # delivered? / mark_delivered!(at:)
        # email_opened? / mark_email_opened!(at:)
        # email_clicked? / mark_email_clicked!(at:)
        # email_bounced? / mark_email_bounced!(at:)
        # email_complained? / mark_email_complained!(at:)
        # email_unsubscribed? / mark_email_unsubscribed!(at:)

        # The gem also supports aliases like opened?/mark_opened! for compatibility.
      RUBY
    }
  ] %>

  <% sections.each do |section| %>
    <div class="space-y-3">
      <%= render FlatPack::SectionTitle::Component.new(
        title: section[:title],
        subtitle: section[:subtitle]
      ) %>

      <%= render FlatPack::CodeBlock::Component.new(
        language: :ruby,
        code: section[:code]
      ) %>
    </div>
  <% end %>

  <p class="text-sm text-(--body-muted-content-color)">
    Notes: methods that accept reference tokens depend on DeliveryToken verification and may raise
    ActiveSupport::MessageVerifier::InvalidSignature. Webhook ingest paths may also raise
    RecordingStudioNotificationsEmail::InvalidWebhookPayloadError,
    RecordingStudioNotificationsEmail::UnsupportedWebhookEventError, and
    RecordingStudioNotificationsEmail::InvalidWebhookTransformError for invalid input.
  </p>
</div>
