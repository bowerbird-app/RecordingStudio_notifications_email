<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Install",
    subtitle: "Add the email channel next to notifications.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Add the gems",
    subtitle: "Notifications owns delivery. This gem sends the mail.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    title: "Gemfile",
    wrap: false,
    code: <<~CODE
      gem "recording_studio_notifications"
      gem "recording_studio_notifications_email"
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Generate config and the suppression table",
    subtitle: "Set config.from before the first send.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :bash,
    title: "Terminal",
    wrap: false,
    code: <<~CODE
      bundle install
      bin/rails generate recording_studio_notifications:install
      bin/rails db:migrate
      bin/rails generate recording_studio_notifications_email:install
      bin/rails generate recording_studio_notifications_email:migrations
      bin/rails db:migrate
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Register the webhook action",
    subtitle: "Your webhook gem still checks the signature. This channel applies the event.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    title: "Ruby",
    wrap: false,
    code: <<~CODE
      RecordingStudioNotificationsEmail::Webhooks::ApplyEvent.register!(provider: "postmark")
    CODE
  ) %>
</div>
