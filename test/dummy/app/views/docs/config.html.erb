<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Configuration & Usage",
    subtitle: "This email channel requires RecordingStudioNotifications. This guide assumes the core notifications gem is already installed and configured.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Prerequisite",
    subtitle: "Install and configure recording_studio_notifications first, then add this email channel.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    title: "Gemfile",
    code: <<~CODE
      # Host app Gemfile
      gem "recording_studio_notifications"
      gem "recording_studio_notifications_email"
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Configuration",
    subtitle: "Run the installer, then configure the channel in an initializer.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :bash,
    title: "Terminal",
    code: <<~CODE
      bundle install
      bin/rails generate recording_studio_notifications_email:install
    CODE
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    title: "Ruby",
    code: <<~CODE
      # config/initializers/recording_studio_notifications_email.rb
      RecordingStudioNotificationsEmail.configure do |config|
        # Required sender
        config.from = Rails.application.credentials.dig(:notifications, :from_email)

        # Optional reply destination
        config.reply_to = "support@example.com"

        # Optional custom mailer (must implement .with(...).notification and .rollup)
        config.mailer_class = "RecordingStudioNotificationsEmail::NotificationMailer"

        # Optional channel key registered with RecordingStudioNotifications
        config.channel = :email

        # Optional signed reference lifetime (default: 30.days)
        config.signed_reference_expires_in = 7.days

        # Optional Message-ID domain
        config.message_id_domain = "mail.example.com"

        # Optional recipient resolvers by model type
        config.recipients.register(User) { |user| user.notification_email }
        config.recipients.register("default") { |recipient| recipient.email }

      end
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Configuration Options",
    subtitle: "Every configurable setting on RecordingStudioNotificationsEmail::Configuration.",
  ) %>

  <%= render FlatPack::Table::Component.new(data: [
    ["from", "String", "ENV[\"RECORDING_STUDIO_NOTIFICATIONS_EMAIL_FROM\"]", "Required sender address used for all outgoing messages."],
    ["reply_to", "String or Array<String>", "nil", "Optional Reply-To address (or addresses) for outgoing messages."],
    ["mailer_class", "String, Symbol, or Class", "RecordingStudioNotificationsEmail::NotificationMailer", "Mailer used by the adapter. Must support Action Mailer .with(...)."],
    ["channel", "Symbol", ":email", "Channel key registered with RecordingStudioNotifications."],
    ["signed_reference_expires_in", "ActiveSupport::Duration", "30.days", "Expiration window for correlation references in email headers."],
    ["message_id_domain", "String", "nil", "Optional deterministic Message-ID domain for outbound messages."],
    ["recipients", "RecipientRegistry", "recipient.email fallback", "Recipient resolver registry; supports model-specific email resolution."]
], min_width: :none) do |table| %>
  <% table.column(title: "Option") { |row| row[0] } %>
  <% table.column(title: "Type") { |row| row[1] } %>
  <% table.column(title: "Default") { |row| row[2] } %>
  <% table.column(title: "Description") { |row| row[3] } %>
<% end %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Parent Notification Setup",
    subtitle: "Enable :email on each notification type. individual_mailer and rollup_mailer are deprecated.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~CODE
      RecordingStudioNotifications.configure do |config|
        config.notification_types.register(
          :page_comment,
          label: "Page comment",
          default_channels: %i[in_app email],
          available_channels: %i[in_app email],
          scope: :root,
          allowed_cadences: %i[individual daily weekly],
          # Deprecated. Removed in 0.5.0. Use notifications 0.14.3 channel_options.
          individual_mailer: "notification_mailer/individual/page_comment",
          rollup_mailer: "notification_mailer/rollup/page_comment"
        )
      end
    CODE
  ) %>

  <%= render FlatPack::Table::Component.new(data: [
    ["key", "Yes", "Non-blank String or Symbol", "Unique identifier used when creating notifications, for example :page_comment."],
    ["label", "Yes", "String", "Human-readable name shown in notification preferences."],
    ["description", "No", "String or nil", "Supporting copy for the notification preference."],
    ["icon", "No", "String or Symbol; default :bell", "FlatPack icon name displayed with the notification type."],
    ["category", "No", "String or Symbol; default :general", "Preference grouping identifier."],
    ["default_channels", "No", "Array of registered channel keys; default nil", "Channels enabled for new recipients. Include :email to opt into email by default."],
    ["required_channels", "No", "Array of available channel keys; default []", "Channels recipients cannot disable. Every required channel must also be available."],
    ["available_channels", "No", "Array of registered channel keys; defaults to the default and required channels", "Channels recipients may select. Include :email to make this email channel available."],
    ["scope", "No", ":global, :root, or :optional_root; default :optional_root", "Determines whether the preference applies globally, to a required root, or optionally to a root."],
    ["creation_action", "No", "String, Symbol, or nil; default nil", "Optional action identifier associated with creating this notification type."],
    ["allowed_cadences", "No", ":individual, :daily, :every_other_day, :weekly, :biweekly, or :monthly; default [:individual]", "Non-empty cadence choices available to recipients."],
    ["default_cadence", "No", "One allowed cadence; default :individual", "Cadence assigned when the recipient has not selected one."],
    ["required_cadence", "No", "One allowed cadence or nil; default nil", "Locks delivery to a cadence for all recipients."],
    ["individual_mailer", "No", "Deprecated. Removed in 0.5.0.", "Replaced by notifications 0.14.3 channel_options. Template path for :individual deliveries until then."],
    ["rollup_mailer", "No", "Deprecated. Removed in 0.5.0.", "Replaced by notifications 0.14.3 channel_options. Template path for rollup deliveries until then."]
], min_width: :none) do |table| %>
  <% table.column(title: "Parameter") { |row| row[0] } %>
  <% table.column(title: "Required") { |row| row[1] } %>
  <% table.column(title: "Allowed values / default") { |row| row[2] } %>
  <% table.column(title: "Description") { |row| row[3] } %>
<% end %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Sending Notifications",
    subtitle: "Use the parent gem API; do not call the mailer directly.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    title: "Ruby",
    code: <<~CODE
      RecordingStudioNotifications.notify(
        notification_type: :page_comment,
        recipient: user,
        notifiable: page,
        title: "New comment",
        body: "A collaborator commented on your page.",
        url: page_url(page)
      )
    CODE
  ) %>

  <%= render FlatPack::Table::Component.new(data: [
    ["notification_type", "Yes", "Registered String or Symbol key", "The notification type registered through config.notification_types.register."],
    ["recipient", "Yes", "Application record", "Person or entity that receives the notification and whose preferences determine enabled channels and cadence."],
    ["title", "Yes", "Non-blank String", "Notification heading used by in-app and email deliveries."],
    ["body", "No", "String or nil; default nil", "Optional notification detail."],
    ["url", "No", "Safe application URL or nil; default nil", "Destination opened from the notification. The parent gem validates URLs for safety."],
    ["metadata", "No", "Hash; default {}", "Structured application data retained with the notification."],
    ["actor", "No", "Application record or nil; defaults to the configured actor resolver", "The user or system actor responsible for the event."],
    ["notifiable", "No", "Application record or nil", "Domain object the notification concerns. It can supply root-recording context."],
    ["recording", "No", "RecordingStudio::Recording or nil", "Recording context for non-global notifications. Its root must match any supplied root or notifiable record."],
    ["root_recording", "For scope: :root", "Root RecordingStudio::Recording or nil", "Required for root-scoped types unless it can be resolved consistently from recording or notifiable."],
    ["channels", "No", "Array of registered, available channel keys; defaults to the type or global default", "Requested delivery channels. Required channels are always included, and recipient preferences can disable optional channels."],
    ["idempotency_key", "No", "Non-blank String or nil; default nil", "Prevents duplicate notifications for the same recipient when the same event is retried."],
    ["deliver_later", "No", "true, false, or nil; default is the parent configuration", "Overrides whether immediate deliveries are enqueued or processed in the current request. Rollup deliveries remain scheduled by cadence."]
], min_width: :none) do |table| %>
  <% table.column(title: "Parameter") { |row| row[0] } %>
  <% table.column(title: "Required") { |row| row[1] } %>
  <% table.column(title: "Allowed values / default") { |row| row[2] } %>
  <% table.column(title: "Description") { |row| row[3] } %>
<% end %>

  <p class="text-sm">Delivery remains owned by RecordingStudioNotifications. This channel is registered during Rails preparation and calls <code class="rounded bg-slate-100 px-1 py-0.5 text-xs">deliver_now</code> inside the parent delivery workflow so delivery status and retries remain centralized.</p>

</div>
