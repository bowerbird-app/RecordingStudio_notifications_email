<%= render FlatPack::Sidebar::Component.new(side: sidebar_side) do |sidebar| %>
  <% sidebar.header do %>
    <% version_badge = render FlatPack::Sidebar::Badge::Component.new(
      value: "v#{RecordingStudioNotificationsEmail::VERSION}",
      style: :muted,
      class: "ml-2"
    ) %>
    <%= render FlatPack::Sidebar::Header::Component.new(
      brand_abbr: "RS",
      title: safe_join(["Mail", version_badge]),
      collapsible: true,
      show_version: false
    ) %>
  <% end %>

  <% sidebar.items do %>
    <nav class="py-4 space-y-1" aria-label="Main navigation">
      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "Home",
        href: main_app.root_path,
        icon: :home
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "Pages",
        href: main_app.pages_path,
        icon: :document_text
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "Install",
        href: main_app.docs_install_path,
        icon: :arrow_down_tray
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "Config",
        href: main_app.docs_config_path,
        icon: :settings
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "Methods",
        href: main_app.docs_methods_path,
        icon: :code_bracket
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "Webhook Lab",
        href: main_app.docs_webhook_lab_path,
        icon: :paper_airplane
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "Notifications",
        href: "/recording_studio_notifications",
        icon: :bell_alert
      ) %>

      <% if Rails.env.development? %>
        <%= render FlatPack::Sidebar::Item::Component.new(
          text: "Letter Opener",
          href: "/letter_opener",
          icon: :envelope,
          target: "_blank",
          rel: "noopener"
        ) %>
      <% end %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "System alerts",
        href: main_app.new_system_notifications_path,
        icon: :megaphone
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "Recordable types",
        href: main_app.docs_recordable_types_path,
        icon: :queue_list
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "This workspace",
        href: main_app.docs_recordings_tree_path,
        icon: :folder
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "Gem Views",
        href: main_app.docs_gem_views_path,
        icon: :eye
      ) %>

    </nav>
  <% end %>

  <% sidebar.footer do %>
    <%= render FlatPack::Sidebar::Footer::Component.new(class: "text-sm text-[var(--surface-muted-content-color)]") do %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        text: "Sign out",
        href: main_app.destroy_user_session_path,
        icon: :lock,
        class: "mx-0",
        data: { turbo_method: :delete }
      ) %>
    <% end %>
  <% end %>
<% end %>
